rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each learner can read and write only their own document.
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      // The app writes exactly { v, updatedAt, data } where data is a map.
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['v', 'updatedAt', 'data'])
        && request.resource.data.data is map;
    }
    // AI tutor usage counters are written by the server only (the admin SDK bypasses rules); no client may touch them.
    match /usage/{doc} { allow read, write: if false; }
    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
